<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org for this solution: the machine's NuGet settings list only Visual
  Studio's offline packages, and the app needs System.Data.OleDb to read its
  Access database. Read by dotnet restore and by Visual Studio alike.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
